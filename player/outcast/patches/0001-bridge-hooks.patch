+// ValOutcast overlay mode: the game is played from another window, so Outcast's sound is not switched by window
+// focus. The game code switches it with the console command "vo_mute 1" or "vo_mute 0" instead.
+static void VO_Mute_f( void )
+{
+	const qboolean mute = ( Cmd_Argc() > 1 && atoi( Cmd_Argv( 1 ) ) != 0 ) ? qtrue : qfalse;
+	Com_Printf( "ValOutcast: sound %s\n", mute ? "muted" : "on" );
+	VO_SetOutput( (qboolean)!mute );
+}
+
+static bool VO_Overlay( void )
+{
+	static int overlay = -1;
+	if ( overlay < 0 ) overlay = getenv( "VO_OVERLAY" ) ? 1 : 0;
+	return overlay == 1;
+}
+
 // (De)activates sound playback
