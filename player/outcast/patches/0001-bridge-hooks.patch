 */
+// ValOutcast overlay mode (VO_OVERLAY set): Valheim asks for one picture per frame it draws (it counts up a number in
+// the shared frame file, see protocol/FRAME.md), and Outcast draws one picture per request. That keeps the two games'
+// frames in step instead of two free-running clocks drifting past each other. Until Valheim has asked for the first
+// time, Outcast draws as usual.
+static bool VO_OverlaySkipFrame( void )
+{
+	static int overlay = -1;
+	static const volatile unsigned int *header = NULL;
+	static unsigned int lastSeen = 0;
+	if ( overlay < 0 ) overlay = getenv( "VO_OVERLAY" ) ? 1 : 0;
+	if ( overlay != 1 ) return false;
+	if ( !header ) {
+		const int fd = open( "/dev/shm/valoutcast_frame", O_RDONLY );
+		if ( fd < 0 ) return false;
+		void *map = mmap( NULL, 32, PROT_READ, MAP_SHARED, fd, 0 );
+		close( fd );
+		if ( map == MAP_FAILED ) return false;
+		header = (const volatile unsigned int *)map;
+	}
+	const unsigned int requested = __atomic_load_n( &header[5], __ATOMIC_ACQUIRE );	// byte 20
+	if ( requested == 0 ) return false;
+	static int lastChange = 0;	// a number that stopped changing is left over from a Valheim that quit: draw as usual
+	const int now = Sys_Milliseconds();
+	if ( requested != lastSeen ) {
+		lastSeen = requested;
+		lastChange = now;
+		return false;
+	}
+	return now - lastChange <= 250;
+}
