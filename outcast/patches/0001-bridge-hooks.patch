+// ValOutcast overlay mode (VO_OVERLAY set): once Valheim asks for pictures (see cl_scrn.cpp), each loop below waits for
+// the next request instead of a timer, so a picture is made as soon as it is asked for. Gives up after a while so the
+// game keeps running if Valheim stops asking. Returns true if a request arrived.
+static bool VO_WaitForPictureRequest( void ) {
+	static int overlay = -1;
+	static const volatile unsigned int *header = NULL;
+	static unsigned int lastSeen = 0;
+	if ( overlay < 0 ) overlay = getenv( "VO_OVERLAY" ) ? 1 : 0;
+	if ( overlay != 1 ) return false;
+	if ( !header ) {
+		const int fd = open( "/dev/shm/valoutcast_frame", O_RDONLY );
+		if ( fd < 0 ) return false;
+		void *map = mmap( NULL, 32, PROT_READ, MAP_SHARED, fd, 0 );
+		close( fd );
+		if ( map == MAP_FAILED ) return false;
+		header = (const volatile unsigned int *)map;
+	}
+	if ( __atomic_load_n( &header[5], __ATOMIC_ACQUIRE ) == 0 ) return false;	// byte 20: nobody is asking
+	const int start = Sys_Milliseconds();
+	for ( ;; ) {
+		const unsigned int requested = __atomic_load_n( &header[5], __ATOMIC_ACQUIRE );
+		if ( requested != lastSeen ) {
+			lastSeen = requested;
+			return true;
+		}
+		if ( Sys_Milliseconds() - start >= 50 ) return false;
+		struct timespec ts = { 0, 100000 };	// 0.1 ms
+		nanosleep( &ts, NULL );
+	}
+}
