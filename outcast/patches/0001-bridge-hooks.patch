+// ValOutcast overlay mode (VO_OVERLAY set): only the player and things like missiles and beams are drawn.
+// The level's own people, items, movers and props belong to a world nobody sees.
+static qboolean VO_HideEntity( const centity_t *cent )
+{
+	static int overlay = -1;
+	if ( overlay < 0 ) overlay = getenv( "VO_OVERLAY" ) ? 1 : 0;
+	if ( !overlay || cent->currentState.number == 0 ) return qfalse;
+	switch ( cent->currentState.eType ) {
+	case ET_PLAYER: case ET_ITEM: case ET_MOVER: case ET_GENERAL: case ET_THINKER: case ET_CLOUD:
+		return qtrue;
+	default:
+		return qfalse;
+	}
+}
+
 static void CG_AddCEntity( centity_t *cent )
 {
 	// event-only entities will have been dealt with already
 	if ( cent->currentState.eType >= ET_EVENTS ) {
 		return;
 	}
+	if ( VO_HideEntity( cent ) ) {
+		return;
+	}
 
 	//we must have restarted the game
 	if (!cent->gent)
